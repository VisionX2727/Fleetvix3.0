{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "cd artifacts/fleet-manager && PORT=23693 BASE_PATH=/ pnpm run build",
  "outputDirectory": "artifacts/fleet-manager/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fx-99999-driver-owner-selection--moonknighttoffi.replit.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
